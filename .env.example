# Copy to `.env` and fill in only the values needed by the scripts you run.
# Qwen deploy scripts load this file automatically. ENV_FILE can select a
# different file.

# Storage bucket holding the pre-converted model weights, e.g. an S3 bucket name.
export S3_MODEL_BUCKET=

# Qwen3.6-27B vLLM-Neuron serving.
export QWEN27_VLLM_IMAGE=
export QWEN27_MODEL_DIR=
export QWEN27_EAGLE3_MODEL_DIR=
export QWEN27_VLLM_PLUGIN_DIR=
export QWEN27_COMPILE_CACHE_DIR=
export QWEN27_EAGLE3_COMPILE_CACHE_DIR=

# Qwen3.6-35B-A3B PyTorch-Native profiling.
# QWEN35_NATIVE_IMAGE: pin by DIGEST (@sha256:...) for any number you intend to
# quote -- a :latest tag drifts between hosts, and the image is part of the NEFF
# cache key, so a drifted image is a 100% cache miss and a different compiler.
export QWEN35_NATIVE_IMAGE=
export QWEN35_MODEL_DIR=
export QWEN35_NKILIB_DIR=
export QWEN35_PROFILE_ROOT=

# Scratch root on the Trn2 box for the deploy/ benchmark + gate runners: logs,
# per-config compiler caches, the nkilib checkout and the staged src tree all
# live under it (e.g. /mnt/nvme/lnc1-work). Instance store -- see the reboot rule
# in PREFILL_RECIPE.md. Required by deploy/bench_env.sh; not derived, because the
# package sits three levels below it on a box and two in a git checkout.
export QWEN35_WORK_DIR=

# BF16 model dir is QWEN35_MODEL_DIR above; FP8 expert weights (max-decode recipe).
export QWEN35_FP8_MODEL_DIR=

# Hosts/regions for the PREFILL_RECIPE.md / DECODE_RECIPE.md compile+transfer steps.
# QWEN35_RUN_HOST is the Trn2 that executes the benchmark (instance-id or ssh target).
# QWEN35_COMPILE_HOST is the optional Trn1.32xlarge for the fast decode cross-compile
# (leave blank to compile natively on Trn2). Prefill (LNC=2) must compile on Trn2.
export QWEN35_RUN_HOST=
export QWEN35_RUN_REGION=
export QWEN35_COMPILE_HOST=
export QWEN35_COMPILE_REGION=

# Qwen3.6-35B-A3B reusable compiler cache. The cache directory is the complete
# host directory mounted at /tmp in the Native container, not an individual NEFF.
export QWEN35_COMPILER_CACHE_DIR=
export QWEN35_COMPILER_CACHE_S3_URI=
export QWEN35_COMPILER_CACHE_S3_REGION=

# Optional location for the caller-scoped cross-compile platform-identity shim.
# The default is deploy/cross_compile/build/libnrt_platform_target_override.so.
export QWEN35_PLATFORM_TARGET_SHIM=
